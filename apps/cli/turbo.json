{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // guide.test.ts reads docs/getting-started.md and .env.example from the repository root, so an
      // edit to either alone must miss the cache (G1).
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/getting-started.md",
        "$TURBO_ROOT$/.env.example"
      ]
    },
    "dev": {
      // What the CLI's dev task reads when it runs `src/index.ts`: the API it calls
      // (resolveApiUrl in src/api.ts), and the DevTools and Motel exporters in src/observability (LOB-101).
      "env": [
        "FACTORY_API_URL",
        "API_URL",
        "DEVTOOLS",
        "DEVTOOLS_URL",
        "MOTEL_URL",
        "OTEL_SERVICE_NAME"
      ],
      // The control-plane credential every call sends (src/rpc.ts, LOB-20): a secret, so it reaches
      // the process without entering the task hash or the cache key.
      "passThroughEnv": ["FACTORY_API_TOKEN"]
    }
  }
}
