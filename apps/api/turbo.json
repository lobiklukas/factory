{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // Serves the RPC router over a real Postgres log (LOB-213), so a cached pass proves nothing.
      "cache": false
    },
    "dev": {
      // Every variable apps/api reads at boot (ServerConfig, the model backend, the session root,
      // the Motel and DevTools exporters, DATABASE_MAX_CONNECTIONS via storage-postgres). Strict Mode
      // strips anything not declared here, so a value set in the shell silently does nothing (LOB-101).
      "env": [
        "PORT",
        "HOST",
        "IDLE_TIMEOUT",
        "ALLOWED_ORIGINS",
        "MAX_REQUEST_BODY_BYTES",
        "MODEL_BACKEND",
        "FAUX_COMMAND",
        "FAUX_EVERY_TURN",
        "APPROVAL_REQUIRED",
        "FAUX_ASK",
        "FAUX_COST",
        "SESSION_BUDGET",
        "ROLE_MODELS",
        "FAUX_VERIFY",
        "FAUX_SLEEP_MS",
        "SESSION_ROOT",
        "SESSION_IDLE_TIMEOUT_MS",
        "PR_CAP_MAX_FILES",
        "PR_CAP_MAX_LINES",
        "DATABASE_MAX_CONNECTIONS",
        "MOTEL_URL",
        "OTEL_SERVICE_NAME",
        "DEVTOOLS",
        "DEVTOOLS_URL",
        "GITHUB_APP_ID",
        "GITHUB_APP_INSTALLATION_ID",
        "GITHUB_API_URL"
      ],
      // A secret: it must reach the process but must not enter the task hash or the cache key.
      "passThroughEnv": [
        "ANTHROPIC_API_KEY",
        "GITHUB_TOKEN",
        "GITHUB_APP_PRIVATE_KEY"
      ]
    }
  }
}
