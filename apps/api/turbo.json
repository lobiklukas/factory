{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // Serves the RPC router over a real Postgres log (LOB-213), so a cached pass proves nothing.
      "cache": false
    },
    "dev": {
      // Every variable apps/api reads (ServerConfig, the model backend, the session root, the Motel, OTLP metrics
      // and DevTools exporters, DATABASE_MAX_CONNECTIONS via storage-postgres, and the trigger,
      // Linear, Sentry, Jira, Slack and GitHub webhook receivers and their write-backs). Strict Mode strips anything not declared here,
      // so a value set in the shell silently does nothing (LOB-101). A guard in
      // packages/storage-postgres/src/turbo-env.test.ts scans the sources for every
      // `process.env["X"]` and `Config.*("X")` and fails on a name missing from `env` or
      // `passThroughEnv` below (LOB-257).
      "env": [
        "PORT",
        "HOST",
        "IDLE_TIMEOUT",
        "ALLOWED_ORIGINS",
        "MAX_REQUEST_BODY_BYTES",
        "MODEL_BACKEND",
        "FAUX_COMMAND",
        "FAUX_EVERY_TURN",
        "APPROVAL_REQUIRED",
        "FAUX_ASK",
        "FAUX_SPEC",
        "FAUX_DECOMPOSITION",
        "FAUX_PLAN_FRESHNESS",
        "FAUX_REVIEW",
        "FAUX_COST",
        "SESSION_BUDGET",
        "ROLE_MODELS",
        "ROLE_POLICIES",
        "DEFAULT_MODEL",
        "FAUX_VERIFY",
        "FAUX_SLEEP_MS",
        "FAUX_FAIL",
        "FAUX_MODEL_SCRIPTS",
        "SESSION_ROOT",
        "SESSION_IDLE_TIMEOUT_MS",
        "SESSION_MAX_CONCURRENT",
        "SETUP_TIMEOUT_SECONDS",
        "SANDBOX_RUNTIME",
        "PR_CAP_MAX_FILES",
        "PR_CAP_MAX_LINES",
        "DATABASE_MAX_CONNECTIONS",
        "MOTEL_URL",
        "OTEL_SERVICE_NAME",
        "OTEL_EXPORTER_OTLP_METRICS_ENDPOINT",
        "OTEL_METRIC_EXPORT_INTERVAL",
        "DEVTOOLS",
        "DEVTOOLS_URL",
        "GITHUB_APP_ID",
        "GITHUB_APP_INSTALLATION_ID",
        "GITHUB_REVIEWER_APP_ID",
        "GITHUB_REVIEWER_APP_INSTALLATION_ID",
        "GITHUB_API_URL",
        "DOCS_SCHEDULE_MS",
        "DOCS_SCHEDULE_REPO",
        "MISSION_RESUME",
        "TRIGGER_RULES",
        "TRIGGER_SECRET_HEADER",
        "TRIGGER_DELIVERY_HEADER",
        "TRIGGER_MAX_BODY_BYTES",
        "LINEAR_API_URL",
        "LINEAR_STATE_STARTED",
        "LINEAR_STATE_IN_REVIEW",
        "LINEAR_STATE_DONE",
        "LINEAR_SESSION_URL_BASE",
        "SENTRY_RATE_LIMIT",
        "SENTRY_RATE_WINDOW_SECONDS",
        "SENTRY_MIN_LEVEL",
        "SENTRY_ENVIRONMENTS",
        "SENTRY_RELEASES",
        "SENTRY_API_URL",
        "SENTRY_SESSION_URL_BASE",
        "GITHUB_WEBHOOK_MAX_BODY_BYTES",
        "GITHUB_MENTION",
        "PLAN_FRESHNESS",
        "PLAN_FRESHNESS_MAX_COST",
        "GITHUB_SESSION_URL_BASE",
        "JIRA_BASE_URL",
        "JIRA_EMAIL",
        "JIRA_SESSION_URL_BASE",
        "SLACK_API_URL",
        "SLACK_CHANNELS",
        "SLACK_TEXT",
        "SLACK_SESSION_URL_BASE",
        "NODE_ENV",
        "FACTORY_API_ACTOR",
        "FACTORY_API_AUTH",
        "NOTIFY_NTFY_URL",
        "NOTIFY_TYPES",
        "NOTIFY_LINK_BASE",
        "NOTIFY_POLL_MS"
      ],
      // A secret: it must reach the process but must not enter the task hash or the cache key.
      // The ANTHROPIC_* names are every variable pi-ai's Anthropic provider authenticates from, which
      // pi-ai reads itself rather than through `Config` (LOB-258), so the scanning guard cannot see
      // them; the federation ids ride along because they only mean something beside the token file.
      // CLAUDE_CODE_OAUTH_TOKEN is never used, only noticed, so the boot can say it is not read.
      "passThroughEnv": [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_OAUTH_TOKEN",
        "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_FEDERATION_RULE_ID",
        "ANTHROPIC_ORGANIZATION_ID",
        "ANTHROPIC_IDENTITY_TOKEN_FILE",
        "ANTHROPIC_SERVICE_ACCOUNT_ID",
        "ANTHROPIC_WORKSPACE_ID",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "GITHUB_TOKEN",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_REVIEWER_TOKEN",
        "GITHUB_REVIEWER_APP_PRIVATE_KEY",
        "GITHUB_WEBHOOK_SECRET",
        "TRIGGER_SECRET",
        "LINEAR_WEBHOOK_SECRET",
        "LINEAR_API_KEY",
        "SENTRY_CLIENT_SECRET",
        "SENTRY_API_TOKEN",
        "JIRA_WEBHOOK_SECRET",
        "JIRA_API_TOKEN",
        "SLACK_SIGNING_SECRET",
        "SLACK_BOT_TOKEN",
        // The control plane's own credentials (LOB-20): the shared token and the per-actor table.
        "FACTORY_API_TOKEN",
        "FACTORY_API_TOKENS",
        // The notifier's destinations (S-notifications): a Slack webhook URL and an ntfy topic are
        // each the credential to post there, and an ntfy token is one outright.
        "NOTIFY_SLACK_WEBHOOK_URL",
        "NOTIFY_NTFY_TOPIC",
        "NOTIFY_NTFY_TOKEN",
        // The key the repos' secrets are encrypted under (S-agent-secrets, `@repo/core`'s
        // SecretService): the one value that opens every stored secret.
        "FACTORY_SECRETS_KEY"
      ]
    }
  }
}
