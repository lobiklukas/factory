{
  "name": "factory",
  "private": true,
  "type": "module",
  "overrides": {
    "@effect/platform-node-shared": "4.0.0"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && git clean -xdf node_modules .cache .turbo dist tsconfig.tsbuildinfo",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "turbo run test",
    "m0": "bun packages/harness/src/m0-live-turn.ts",
    "motel": "bun run --cwd tools/motel motel",
    "motel:start": "bun run --cwd tools/motel start",
    "motel:status": "bun run --cwd tools/motel status",
    "motel:stop": "bun run --cwd tools/motel stop",
    "prepare": "effect-tsgo patch --oxlint && bun install --cwd tools/motel --frozen-lockfile"
  },
  "devDependencies": {
    "@effect/tsgo": "0.38.0",
    "@playwright/test": "^1.63.0",
    "@repo/domain": "workspace:*",
    "effect": "4.0.0",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "stack-effect": "0.17.0",
    "turbo": "^2.9.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
