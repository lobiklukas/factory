{
  "name": "factory",
  "private": true,
  "type": "module",
  "overrides": {
    "@effect/platform-node-shared": "4.0.0"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "DO_NOT_TRACK=1 TURBO_TELEMETRY_DISABLED=1 TURBO_NO_UPDATE_NOTIFIER=1 turbo run build",
    "dev": "DO_NOT_TRACK=1 TURBO_TELEMETRY_DISABLED=1 TURBO_NO_UPDATE_NOTIFIER=1 turbo run dev",
    "type-check": "DO_NOT_TRACK=1 TURBO_TELEMETRY_DISABLED=1 TURBO_NO_UPDATE_NOTIFIER=1 turbo run type-check type-check:pi",
    "type-check:pi": "tsc -p .pi/tsconfig.json",
    "clean": "DO_NOT_TRACK=1 TURBO_TELEMETRY_DISABLED=1 TURBO_NO_UPDATE_NOTIFIER=1 turbo run clean && git clean -xdf node_modules .cache .turbo dist tsconfig.tsbuildinfo",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "DO_NOT_TRACK=1 TURBO_TELEMETRY_DISABLED=1 TURBO_NO_UPDATE_NOTIFIER=1 turbo run test",
    "m0": "bun packages/harness/src/m0-live-turn.ts",
    "review-eval": "bash .pi/skills/verify-api/review-eval.sh",
    "motel": "bun run --cwd tools/motel motel",
    "motel:start": "bun run --cwd tools/motel start",
    "motel:status": "bun run --cwd tools/motel status",
    "motel:stop": "bun run --cwd tools/motel stop",
    "prepare": "effect-tsgo patch --oxlint && bun install --cwd tools/motel --frozen-lockfile",
    "ralph": "bash .pi/ralph/loop.sh",
    "ralph:setup": "bash .pi/ralph/loop.sh setup",
    "ralph:run": "bash .pi/ralph/loop.sh run",
    "ralph:start": "bash .pi/ralph/loop.sh start",
    "ralph:kill": "bash .pi/ralph/loop.sh kill",
    "ralph:split": "bash .pi/ralph/loop.sh split",
    "ralph:audit": "bash .pi/ralph/loop.sh audit",
    "ralph:status": "bash .pi/ralph/loop.sh status",
    "ralph:stop": "bash .pi/ralph/loop.sh stop",
    "rulesets": "bun infra/src/rulesets.ts"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.0.3",
    "@earendil-works/pi-durable": "1.0.3",
    "@effect/platform-bun": "4.0.0",
    "@effect/tsgo": "0.38.0",
    "@playwright/test": "^1.63.0",
    "@repo/core": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/harness": "workspace:*",
    "@repo/infra": "workspace:*",
    "@repo/sandbox": "workspace:*",
    "@repo/sandbox-kubernetes": "workspace:*",
    "@repo/storage-postgres": "workspace:*",
    "@types/bun": "^1.2.17",
    "effect": "4.0.0",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "stack-effect": "0.17.0",
    "turbo": "^2.9.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ]
}
