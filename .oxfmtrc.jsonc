{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.gen.ts",
    "**/generated/**",
    "**/.cache/**",
    "**/.turbo/**",
    // A released manifest, vendored byte for byte: its checksum is in SHA256SUMS beside it.
    "infra/kind/agent-sandbox/**",
  ],
}
