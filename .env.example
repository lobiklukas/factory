# Local development credentials.
#
# Copy to `.env` (gitignored) and fill in:
#   cp .env.example .env
#
# `bun run dev` loads this file for apps/api, apps/cli and apps/web (LOB-256); a variable exported in
# the shell wins over it.
#
# The Anthropic credential (LOB-258). @earendil-works/pi-ai reads it itself, and apps/api picks the
# anthropic backend when any of these resolves. Set ONE; pi-ai tries them in this order:
#   ANTHROPIC_AUTH_TOKEN   a bearer token, sent to api.anthropic.com as `Authorization: Bearer`;
#                          ANTHROPIC_BASE_URL is not honoured, so a gateway's token will not work
#   ANTHROPIC_OAUTH_TOKEN  sent as the API key (an `sk-ant-oat…` access token as a bearer)
#   ANTHROPIC_API_KEY      an Anthropic Console API key: the usual choice
# or workload identity federation, which needs all three of
#   ANTHROPIC_FEDERATION_RULE_ID, ANTHROPIC_ORGANIZATION_ID, ANTHROPIC_IDENTITY_TOKEN_FILE
# (ANTHROPIC_SERVICE_ACCOUNT_ID and ANTHROPIC_WORKSPACE_ID optional beside them).
# An empty or whitespace-only value counts as unset. The boot log names the variable that
# authenticated (`model backend: anthropic (auth: ANTHROPIC_API_KEY)`), never its value.
#
# Not supported: CLAUDE_CODE_OAUTH_TOKEN and a Claude Pro/Max login. pi-ai does not read the
# former, and the API keeps no stored login for the latter. The boot says when
# CLAUDE_CODE_OAUTH_TOKEN is set and nothing else is. A subscription access token passed as
# ANTHROPIC_OAUTH_TOKEN works only because pi-ai accepts it; it is never refreshed, so it stops
# when it expires: not recommended for unattended sessions.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_OAUTH_TOKEN=

# GitHub token for the control plane's own calls to GitHub (push, PR creation). It is never given
# to a session's directory or environment. Unset: those calls fail with a typed "missing" error.
# GITHUB_TOKEN=
#
# Or the GitHub App flow (LOB-55): set all three, and leave GITHUB_TOKEN unset. The App mints a
# short-lived installation token per repo. GITHUB_APP_PRIVATE_KEY is the PEM; literal \\n is accepted.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_API_URL=https://api.github.com

# Local Postgres from `docker compose up -d --wait postgres` (the default, so usually unset).
# DATABASE_URL=postgres://factory:factory@localhost:5442/factory

# The origins the browser may call the API from, comma-separated (CORS). The default is the
# dashboard's own address; set it when the dashboard runs on another port or host, or its calls are
# blocked.
# ALLOWED_ORIGINS=http://localhost:3000

# Control-plane identity (LOB-20). Set FACTORY_API_TOKEN and every RPC needs it as
# `Authorization: Bearer <token>`, and every write records FACTORY_API_ACTOR (default `operator`)
# rather than the actor a caller declares. The CLI sends FACTORY_API_TOKEN itself; the dashboard
# sends VITE_FACTORY_API_TOKEN, so set both to the same value. At least 16 characters, e.g.
# `openssl rand -hex 24`. FACTORY_API_TOKENS adds one credential per person or service.
# Unset, auth is off: every call is served and a write keeps the actor its caller declared, so the
# API binds loopback only (HOST=127.0.0.1, the default). A HOST beyond loopback with no token
# refuses the boot unless FACTORY_API_AUTH=off says that is intended.
# FACTORY_API_TOKEN=
# VITE_FACTORY_API_TOKEN=
# FACTORY_API_ACTOR=operator
# FACTORY_API_TOKENS=amy=<token>,ci=<token>
# HOST=127.0.0.1
# FACTORY_API_AUTH=off

# Which model sessions run against (apps/api). Unset: anthropic when an Anthropic credential above
# resolves, otherwise pi-ai's deterministic faux provider, which runs sessions offline with scripted
# answers. `anthropic` with no credential refuses to boot (AnthropicCredentialMissing) rather than
# failing on the first request.
# MODEL_BACKEND=anthropic

# A second model provider beside the backend's (S-model-provider-breadth): any OpenAI-compatible
# Chat Completions endpoint. Its models are `openai-compatible/<id>`, which ROLE_MODELS,
# DEFAULT_MODEL and ROLE_FALLBACKS may name. MODELS is a list of ids or a JSON array with each one's
# price (US dollars per million tokens) and window. The key is read by pi-ai, never logged; unset,
# the endpoint is keyless. Half of BASE_URL/MODELS fails the boot.
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_COMPATIBLE_MODELS=[{"id":"llama-3.1-70b","cost":{"input":0.6,"output":0.6}}]
# OPENAI_COMPATIBLE_API_KEY=

# The models a role's runs fall back to, in order, when theirs answers overloaded or unavailable
# (a 529 or 503): `role=provider/modelId|provider/modelId`, comma-separated. Each switch is a line in
# the session's transcript, and the session stays on the fallback. Unset: no role falls back.
# ROLE_FALLBACKS=builder=openai-compatible/llama-3.1-70b

# Where a session's working directory is created, one directory per session. Local-dev scratch
# until M6 gives each session a git worktree.
# SESSION_ROOT=.factory/sessions

# Release a session's owner (and its in-memory fold) after this long untouched. A read counts as
# use. Sweeps run at least twice per window.
# SESSION_IDLE_TIMEOUT_MS=900000

# Admission control (LOB-70): how many sessions this process runs at once (open owners: a harness,
# a held log, a worktree). One more is refused with SessionError `at_capacity` — a webhook delivery
# with `503 at-capacity` and Retry-After — until the idle sweep above releases one. Not dollars
# (SESSION_BUDGET) and not a delivery rate (SENTRY_RATE_LIMIT). Unset: no cap.
# SESSION_MAX_CONCURRENT=8

# How long each step of a new worktree's setup (the repo's declared install, then build) may run,
# in seconds (F24). A step that outlives it is stopped and the setup fails: the first message is
# refused `setup_failed` and a card's run parks the card. A slow monorepo install needs more.
# A positive number up to 2147483; anything else fails the boot. Unset: 1800 (`factory doctor` shows the value).
# SETUP_TIMEOUT_SECONDS=1800

# Aggregate spend caps (S-aggregate-spend-caps): dollars a repository or an actor may spend per UTC
# day and month. Once a window's spend has reached a cap, a new run on that repository (or by that
# actor) is refused with SessionError `budget_exceeded` — a webhook delivery with `503 at-capacity` and a
# `Retry-After` that is when the window ends —
# until the window ends; other repositories and actors are unaffected. Crossing 80% and 100% raises
# an attention item and a notification (NOTIFY_*). JSON; an unknown key fails the boot. Unset: no cap.
# SPEND_CAPS={"repos":{"acme/web":{"daily":20,"monthly":300}},"actors":{"alice":{"daily":5}}}

# The spend ceiling a session gets when its create names none (LOB-163), in US dollars; a fork or a
# replay of an uncapped session gets it too. Unset: no default cap. A value that is not a positive
# number fails the boot.
# SESSION_BUDGET=5

# How large a session's diff may be before the PR step opens nothing (LOB-227): more files or more
# changed lines than this is refused, naming the limit. The defaults are the control plane's own.
# PR_CAP_MAX_FILES=50
# PR_CAP_MAX_LINES=2000

# Where sessions' commands run: the sandbox runtime each session's worktree is bound to
# (`packages/sandbox`). `in-process`, the only one so far, runs them on this host as the server's
# user, in the session's worktree, with the server's environment less its credentials.
# SANDBOX_RUNTIME=in-process

# Inbound triggers (`packages/core/src/TriggerService.ts`, apps/api's `/webhooks/*`). A route with
# no secret refuses every delivery with 503, so a delivery can never start a session unsigned. The
# rules map an event's label (or `"team": "ENG"`, a Linear team key) to a repo, a base ref, and a
# prompt template. They are the fallback: routes stored over RPC (`addTriggerRoute`) are read per
# delivery and win, and a value that does not decode refuses the boot:
#   TRIGGER_RULES=[{"label":"factory","repo":"owner/name","baseRef":"main","prompt":"Work on {{title}}: {{body}}"}]
# TRIGGER_SECRET=            # hmac-sha256 secret for /webhooks/generic
# TRIGGER_SECRET_HEADER=     # header the signature arrives in (default x-trigger-signature)
# TRIGGER_DELIVERY_HEADER=   # header carrying the delivery id (default x-trigger-delivery)
# TRIGGER_MAX_BODY_BYTES=    # cap on a delivery body (default 65536)
# LINEAR_WEBHOOK_SECRET=     # Linear's webhook signing secret, for /webhooks/linear
# SENTRY_CLIENT_SECRET=      # the Sentry integration's Client Secret, for /webhooks/sentry
# SENTRY_RATE_LIMIT=         # Sentry deliveries that can start work admitted per window, per process (default 20)
# SENTRY_RATE_WINDOW_SECONDS= # the window SENTRY_RATE_LIMIT counts over (default 60)
#                            # concurrent sessions are capped by SESSION_MAX_CONCURRENT (above), not here
# SENTRY_MIN_LEVEL=          # only alerts at least this severe are work: debug|info|warning|error|fatal (default any)
# SENTRY_ENVIRONMENTS=       # comma-separated environments whose alerts are work (default any)
# SENTRY_RELEASES=           # comma-separated releases whose alerts are work; `web@2.*` is a prefix (default any)
# The link back (`packages/core/src/SentryWriteBack.ts`, LOB-83): one note on the alert's Sentry issue
# naming the session, posted once however often the delivery is retried. Best effort: a Sentry that
# refuses or does not answer is logged, and the session runs. Unset token, no note.
# SENTRY_API_TOKEN=          # an internal integration's token, scoped to write issue comments
# SENTRY_API_URL=            # the API root (default https://sentry.io; set it for a self-hosted Sentry)
# SENTRY_SESSION_URL_BASE=   # optional: where a reader finds a session, for the note
# Linear write-back (`packages/core/src/LinearSync.ts`, LOB-15): a delegated issue moves to the
# started state when its session opens, gets its PR (an attachment and one comment with the
# verification evidence) and moves to in review when the PR opens, gets one comment when a run ends
# without a PR, and moves to done when the PR merges. No key: no write-back.
#   LINEAR_API_KEY=                      # a personal API key, sent as-is; an OAuth token as "Bearer <token>"
#   LINEAR_STATE_STARTED=In Progress     # the team's workflow state names (these are the defaults)
#   LINEAR_STATE_IN_REVIEW=In Review
#   LINEAR_STATE_DONE=Done
#   LINEAR_SESSION_URL_BASE=             # optional: where a reader finds a session, for the comment
#   LINEAR_API_URL=                      # optional: the GraphQL endpoint (default Linear's own)
#   GITHUB_WEBHOOK_SECRET=               # the secret of a GitHub `pull_request` webhook at /webhooks/github:
#                                        # a merge moves the issue to done, an unmerged close comments
#   GITHUB_WEBHOOK_MAX_BODY_BYTES=       # cap on a /webhooks/github body (default 1048576)
# The docs trigger (`packages/core/src/DocsTrigger.ts`, LOB-197/LOB-234). The same GitHub webhook,
# subscribed to `push` too, starts one docs run on `factory/doc-<push>` for each push to a
# registered repo's default branch (GITHUB_WEBHOOK_SECRET above; a push to any other branch is 400).
# The schedule starts one per interval over one registered repo; unset, there is no schedule.
#   DOCS_SCHEDULE_MS=                    # the interval in milliseconds (unset or 0: off)
#   DOCS_SCHEDULE_REPO=                  # owner/name; required when DOCS_SCHEDULE_MS is set
#   AUTOMATIONS_POLL_MS=                 # how often scheduled automations are checked (default 15000; 0: off)
# Missions (LOB-231) and runs (LOB-25). The boot reopens and resumes every mission and every run its
# database says is in flight under this process's SESSION_ROOT, so one a restart or a kill interrupted
# carries on where it died.
# There is no ownership lease: a second API on the same database *and* root must turn it off.
#   MISSION_RESUME=                      # false: leave missions and runs in flight for their next caller (default true)
# The Jira, Slack and GitHub-issue adapters (`packages/core/src/{Jira,Slack,GitHub}.ts`, LOB-189,
# LOB-191, LOB-190), served by apps/api (LOB-259). Each is a route that answers 503 until its secret
# is set, and a write-back that answers on the source once its client is configured; a delivery maps
# to a repo through TRIGGER_RULES like every other (a Slack message carries its channel id as its
# label; a GitHub issue carries its labels, and an `@factory` comment adds the label `factory`).
#
# POST /webhooks/jira: an admin webhook registered with a secret (it signs X-Hub-Signature).
#   JIRA_WEBHOOK_SECRET=                 # the webhook's secret; unset, the route refuses everything
# The comment back on the issue needs all three of these, or none (`jiraConfigFromEnv`):
#   JIRA_BASE_URL=https://owner.atlassian.net
#   JIRA_EMAIL=agent@example.com         # the account the token belongs to (Basic auth)
#   JIRA_API_TOKEN=                      # Jira Cloud API token
#   JIRA_SESSION_URL_BASE=               # optional: where a reader finds a session, for the comment
#
# POST /webhooks/slack: an Events API subscription (message.channels and/or app_mention), whose
# `url_verification` handshake is answered once the signing secret is set.
#   SLACK_SIGNING_SECRET=                # the app's signing secret; unset, the route refuses everything
#   SLACK_CHANNELS=C0ENG,C0OPS           # channel ids to watch; a message elsewhere is recorded skipped
#   SLACK_TEXT=                          # optional: a phrase a message must contain
# The reply in the thread (the session's link, and the PR's link once the PR opens) needs the bot
# token, with SLACK_SIGNING_SECRET and SLACK_CHANNELS (`slackConfigFromEnv`):
#   SLACK_BOT_TOKEN=                     # xoxb-..., scope chat:write and channels:history
#   SLACK_SESSION_URL_BASE=              # optional: where a reader finds a session, for the reply
#   SLACK_API_URL=                       # optional: Slack's API root (default https://slack.com)
#
# POST /webhooks/github, subscribed to `issues` and `issue_comment` too (GITHUB_WEBHOOK_SECRET above):
# a `factory` label on an issue, or a comment mentioning `@factory`, starts one session on the
# issue's repo (registered) and comments its link on the issue, with GITHUB_TOKEN or the App.
#   GITHUB_MENTION=@factory              # the handle a comment mentions (an `@` is added if missing); the label is the handle without `@`
# Only an owner, member or collaborator (author_association) may start work by mention.
#   GITHUB_SESSION_URL_BASE=             # optional: where a reader finds a session, for the comment

# Send OTLP logs and traces to a local motel server (https://github.com/kitlangton/motel).
# Unset: the apps and CLI ship no telemetry at all, which is right for every run that is not
# being debugged. Set it, then read what arrives with `bun run motel`:
#
#   MOTEL_URL=http://127.0.0.1:27686
#   OTEL_SERVICE_NAME=factory-api   # default: factory-api for apps/api, factory-cli for apps/cli
#
# See tools/motel/README.md for the scripts and .pi/skills/motel-debug for how to query it.

# Export the API's metrics over OTLP/HTTP (JSON) to a collector (docs/metrics.md). motel has no
# metrics route, so this is a separate endpoint. Unset: no metrics exporter at all. The endpoint is
# the full URL, used as given; it must be http: or https:, or the boot is refused.
# OTEL_SERVICE_NAME above names the resource for both exporters.
#
#   OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
#   OTEL_METRIC_EXPORT_INTERVAL=60000   # milliseconds between exports; must be positive

# Tell a person when a run needs them (S-notifications): a card parked on a question, a pending
# approval, a card whose run waits at a human gate, or a run that failed (its budget stopped it, or
# its model request failed), or a spend cap at 80% or 100%. One message per event per sink, linked
# to the card; a restart sends
# nothing twice. No sink set: notifications are off, and the boot says so.
#
#   NOTIFY_SLACK_WEBHOOK_URL=            # a Slack incoming webhook (the URL is the credential)
#   NOTIFY_NTFY_TOPIC=                   # an ntfy topic, for the phone app
#   NOTIFY_NTFY_URL=                     # optional: the ntfy server (default https://ntfy.sh)
#   NOTIFY_NTFY_TOKEN=                   # optional: an ntfy access token, for a protected topic
#   NOTIFY_TYPES=question,approval,gate,failed,spend   # optional: which kinds (default all five)
#   NOTIFY_LINK_BASE=http://localhost:3000       # optional: the dashboard's origin (default the first ALLOWED_ORIGINS)
#   NOTIFY_POLL_MS=5000                  # optional: how often the notifier looks
#
# Personal sinks (F21): a person adds an email address or their browser's Web Push on the
# dashboard's Notifications page, and an event for a card they created reaches those sinks only
# (an event with no such owner goes to the sinks above). The page's toggles override NOTIFY_TYPES
# and are live on the next poll, no restart. Each needs the deployment to be able to send:
#
#   NOTIFY_SMTP_URL=smtp://user:password@mail.example.com:587   # email: smtps:// is TLS from the start; the URL holds the password
#   NOTIFY_SMTP_FROM=factory@example.com                        # email: the sender, required with NOTIFY_SMTP_URL
#   NOTIFY_VAPID_PUBLIC_KEY=             # Web Push: the key pair (base64url); `generateVapidKeys()` in @repo/core makes one
#   NOTIFY_VAPID_PRIVATE_KEY=            # Web Push: never logged
#   NOTIFY_VAPID_SUBJECT=mailto:ops@example.com                 # Web Push: a contact for push services (default mailto:<NOTIFY_SMTP_FROM>)
#   NOTIFY_PUSH_ALLOW_INSECURE=false     # optional: accept http: push endpoints, for a loopback fake only
#
# History (F22): delivered notifications and recorded run failures older than this are deleted, at
# most hourly on the poll; an undelivered row, a delivered one whose event is still open, and
# anything inside the failure lookback are never touched.
#
#   NOTIFY_RETENTION_DAYS=30             # optional: default 30
